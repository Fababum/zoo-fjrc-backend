generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String   @default("user")
  password  String 
  createdAt DateTime @default(now())
  artikel   Artikel[]
  orders    Order[]
  paymentMethods PaymentMethod[]
}

model Artikel {
  id           Int      @id @default(autoincrement())
  markdownText String   @db.Text
  markdownTextDe String? @db.Text
  markdownTextEn String? @db.Text
  markdownTextFr String? @db.Text
  markdownTextIt String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       Int
  isActive     Boolean  @default(true)
  user         User     @relation(fields: [userId], references: [id])
}

model Ticket {
  id       Int     @id @default(autoincrement())
  name     String
  preis    Float
  isActive Boolean @default(true)
}

model HomepageBesuchPlanen {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  image       String?
  link        String?
}

model HomepageWhatsNew {
  id          Int     @id @default(autoincrement())
  title       String
  description String  @db.Text
  image       String?
  link        String?
}

model Angebote {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  startTime   DateTime
  endTime     DateTime
  link        String?
  isActive    Boolean  @default(true)
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  items     Json
  total     Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id          Int      @id @default(autoincrement())
  userId      Int
  cardType    String
  last4       String
  firstName   String
  lastName    String
  street      String
  houseNumber String
  addressExtra String?
  postalCode  String
  city        String
  country     String
  phone       String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}
